{
  "manifest_version": 3,
  "name": "dictat",
  "version": "0.4.0",
  "description": "A quiet, fully tunable reading view for en.wiktionary.org: your colours, fonts and layout, etymology timelines, CJK character boxes, audio-only pronunciation, and Naver/Forvo shortcuts.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://en.wiktionary.org/*"
  ],
  "action": {
    "default_title": "dictat: click to turn off/on",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://en.wiktionary.org/wiki/*",
        "https://en.wiktionary.org/w/index.php*"
      ],
      "js": [
        "settings.js",
        "look.js",
        "boot.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://en.wiktionary.org/wiki/*",
        "https://en.wiktionary.org/w/index.php*"
      ],
      "css": [
        "clean.css"
      ],
      "js": [
        "clean.js"
      ],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dictat@local",
      "strict_min_version": "121.0"
    }
  }
}